---
// Keep previously shared URLs working on static hosts, including GitHub Pages.
import { getSortedPosts } from "../../utils/content-utils";
import { getPostUrlBySlug } from "../../utils/url-utils";
export async function getStaticPaths() {
	return (await getSortedPosts("shares")).map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const destination = getPostUrlBySlug(entry.slug, "shares");
const canonical = new URL(destination, Astro.site);
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0;url=${destination}`} /><meta name="robots" content="noindex" /><link rel="canonical" href={canonical} /><title>文章已迁移 · 昊の月</title></head><body><p>文章已迁至分享栏目。<a href={destination}>继续阅读「{entry.data.title}」</a></p><script is:inline define:vars={{ destination }}>location.replace(destination + location.search + location.hash);</script></body></html>
