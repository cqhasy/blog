---
import { Icon } from "astro-icon/components";
import { skillGroups } from "../data/portfolio";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="技能展示" description="Cqhasy 的技术方向与实践范围">
	<header class="page-heading onload-animation">
		<p class="eyebrow">Skills / Focus</p>
		<h1>技术与实践</h1>
		<p>主要使用 Go，探索 AI Agent 与工程工具。</p>
	</header>

	<section class="skill-list" aria-label="技术能力">
		{skillGroups.map((group, index) => (
			<details class="skill-row" open={index === 0}>
				<summary class="skill-heading">
					<span class="skill-icon" aria-hidden="true"><Icon name={group.icon} /></span>
					<div>
						<h2>{group.title}</h2>
						<p>{group.skills.map((skill) => skill.name).join(" / ")}</p>
					</div>
					<span class="skill-toggle" aria-hidden="true">+</span>
				</summary>
				<ul class="skill-items">
					{group.skills.map((skill) => (
						<li>
							<strong>{skill.name}</strong>
							<span>{skill.detail}</span>
						</li>
					))}
				</ul>
			</details>
		))}
	</section>
</MainGridLayout>

<style>
	.page-heading { padding-bottom: 28px; }
	.skill-list { border-top: 1px solid var(--rule); }
	.skill-row { border-bottom: 1px solid var(--rule); }
	.skill-heading { display: flex; align-items: flex-start; gap: 14px; padding: 26px 0; cursor: pointer; list-style: none; }
	.skill-heading::-webkit-details-marker { display: none; }
	.skill-heading > div { flex: 1; min-width: 0; }
	.skill-toggle { color: var(--muted); font-size: 22px; line-height: 1.5; }
	.skill-row[open] .skill-toggle { transform: rotate(45deg); }
	.skill-icon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 34px; width: 34px; height: 34px; border: 1px solid var(--rule); border-radius: 7px; color: var(--muted); }
	.skill-heading h2 { margin: 0; font-size: 18px; line-height: 1.5; font-weight: 600; }
	.skill-heading p { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.8; }
	.skill-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 32px; list-style: none; padding: 0 0 24px 48px; margin: 0; }
	.skill-items li { display: flex; flex-direction: column; gap: 4px; padding: 3px 0 14px; }
	.skill-items strong { font-size: 14px; font-weight: 600; }
	.skill-items span { color: var(--muted); font-size: 12px; line-height: 1.7; }
	@media (max-width: 640px) {
		.skill-heading { padding: 23px 0; }
		.skill-items { gap: 8px 18px; padding-left: 0; }
	}
</style>
