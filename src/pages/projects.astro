---
import { Icon } from "astro-icon/components";
import { portfolioProjects } from "../data/portfolio";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="项目展示" description="Cqhasy 的开源项目与实践作品">
	<header class="page-heading onload-animation">
		<p class="eyebrow">Projects</p>
		<h1>项目</h1>
		<p>Go、AI Agent 与日常使用的小工具。</p>
	</header>

	<section class="project-list" aria-label="项目列表">
		{portfolioProjects.map((project, index) => (
			<article class="project-row onload-animation" style={`animation-delay: calc(var(--content-delay) + ${index * 40}ms)`}>
				<div class="project-title">
					<div class="project-icon" aria-hidden="true"><Icon name={project.icon} /></div>
					<div>
						<div class="project-kicker">
							<span>{project.status}</span>
						</div>
						<h2>{project.name}</h2>
					</div>
				</div>
				<div class="project-content">
					<p>{project.description}</p>
					<div class="project-footer">
						<div class="tech-list" aria-label="使用技术">
							{project.tech.slice(0, 4).map((tech) => <span>{tech}</span>)}
						</div>
						<a class="project-link" href={project.repo} target="_blank" rel="noopener noreferrer">查看仓库 <Icon name="material-symbols:arrow-outward-rounded" /></a>
					</div>
				</div>
			</article>
		))}
	</section>
</MainGridLayout>

<style>
	.page-heading { padding-bottom: 28px; }
	.project-list { display: grid; gap: 16px; }
	.project-row { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: 32px; padding: 26px; border: 1px solid var(--rule); border-radius: 8px; }
	.project-title { display: flex; align-items: flex-start; gap: 14px; }
	.project-icon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 34px; width: 34px; height: 34px; border: 1px solid var(--rule); border-radius: 7px; color: var(--muted); }
	.project-kicker { display: flex; flex-wrap: wrap; gap: 8px; color: var(--faint); font-size: 11px; line-height: 1.5; }
	.project-kicker span + span::before { content: '·'; margin-right: 8px; }
	.project-title h2 { margin: 3px 0 0; font-size: 18px; line-height: 1.5; font-weight: 600; }
	.project-content p { margin: 0 0 18px; color: var(--muted); font-size: 14px; line-height: 1.85; }
	.project-footer { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
	.tech-list { display: flex; flex-wrap: wrap; gap: 8px; color: var(--faint); font: 11px/1.5 'JetBrains Mono Variable', monospace; }
	.tech-list span + span::before { content: ' / '; color: var(--rule); }
	.project-link { display: inline-flex; align-items: center; flex-shrink: 0; gap: 6px; color: var(--ink); font-size: 12px; text-decoration: underline; text-decoration-color: var(--faint); text-underline-offset: 4px; }
	.project-link:hover { color: var(--accent); }
	@media (max-width: 640px) {
		.project-row { grid-template-columns: 1fr; gap: 18px; padding: 22px; }
		.project-footer { align-items: flex-start; flex-direction: column; gap: 14px; }
	}
</style>
