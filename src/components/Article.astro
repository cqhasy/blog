---
import ReadingIcon from "./ReadingIcon.astro";
import * as path from "node:path";
import type { WritingEntry } from "../utils/content-utils";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import Markdown from "./misc/Markdown.astro";
import ImageWrapper from "./misc/ImageWrapper.astro";
import Comment from "./comment/index.astro";
import { getDir, getPostUrlBySlug, getTagUrl, url } from "../utils/url-utils";
import { licenseConfig, profileConfig, siteConfig } from "../config";
interface Props { entry: WritingEntry }
const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const collectionTitle = entry.collection === "shares" ? "分享" : "随笔";
const date = entry.data.published.toISOString().slice(0, 10);
const toc = headings.filter((heading) => heading.depth <= siteConfig.toc.depth);
const jsonLd = {
	"@context": "https://schema.org", "@type": "BlogPosting", headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	author: { "@type": "Person", name: entry.data.author || profileConfig.name },
	datePublished: date, dateModified: (entry.data.updated || entry.data.published).toISOString(),
	inLanguage: (entry.data.lang || siteConfig.lang).replace("_", "-"),
	url: new URL(getPostUrlBySlug(entry.slug, entry.collection), Astro.site).href,
};
---
<MainGridLayout title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle headings={headings}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<article class="reading-article">
		<header class="article-header">
			<a class="text-link back-link" href={url(`/${entry.collection}/`)}><ReadingIcon name="arrow-left" size={16} />{collectionTitle}</a>
			<h1 data-pagefind-meta="title" data-pagefind-body data-pagefind-weight="10">{entry.data.title}</h1>
			<div class="article-meta"><time datetime={date}>{date.replaceAll("-", ".")}</time><span aria-hidden="true">·</span><span class="reading-time"><ReadingIcon name="clock" size={14} />{remarkPluginFrontmatter.minutes || 1} 分钟阅读</span><span aria-hidden="true">·</span><span>{entry.data.author || profileConfig.name}</span>{entry.data.draft && <span>草稿</span>}</div>
			{entry.data.updated && <p class="updated-date">更新于 <time datetime={entry.data.updated.toISOString()}>{entry.data.updated.toISOString().slice(0, 10).replaceAll("-", ".")}</time></p>}
			{entry.data.description && <p class="article-description">{entry.data.description}</p>}
		</header>
		{siteConfig.toc.enable && toc.length > 1 && <details class="article-toc" data-pagefind-ignore><summary><span class="toc-label"><ReadingIcon name="list" size={17} />本文目录 <span class="toc-count">{toc.length} 个章节</span></span><ReadingIcon class="disclosure-mark" name="chevron" size={16} /></summary><nav aria-label="本文目录"><ol>{toc.map((heading) => <li style={`--depth: ${heading.depth - 1}`}><a href={`#${heading.slug}`}>{heading.text.replace(/#$/, "").trim()}</a></li>)}</ol></nav></details>}
		{entry.data.image && <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join(`content/${entry.collection}/`, getDir(entry.id))} alt={entry.data.title} class="article-cover" />}
		<Markdown class="article-body"><Content /></Markdown>
		<footer class="article-end" data-pagefind-ignore>
			{entry.data.tags.length > 0 && <nav class="article-tags" aria-label="文章标签">{entry.data.tags.map((tag) => <a href={getTagUrl(tag)}>#{tag}</a>)}</nav>}
			{licenseConfig.enable && <p class="license-line">本文采用 <a href={entry.data.licenseUrl || licenseConfig.url} rel="license">{entry.data.licenseName || licenseConfig.name}</a> 协议。{entry.data.sourceLink && <a href={entry.data.sourceLink}>原文链接 ↗</a>}</p>}
		</footer>
	</article>
	<Comment post={entry} />
	<nav class="article-pagination" aria-label="继续阅读" data-pagefind-ignore>
		{entry.data.nextSlug ? <a href={getPostUrlBySlug(entry.data.nextSlug, entry.collection)}><span class="pagination-direction"><ReadingIcon name="arrow-left" size={15} />较新一篇</span><strong>{entry.data.nextTitle}</strong></a> : <span />}
		{entry.data.prevSlug ? <a href={getPostUrlBySlug(entry.data.prevSlug, entry.collection)}><span class="pagination-direction">较早一篇<ReadingIcon name="arrow-right" size={15} /></span><strong>{entry.data.prevTitle}</strong></a> : <span />}
	</nav>
</MainGridLayout>

<script>
  // Collapse after following a section so the outline does not cover the text.
  const outline = document.querySelector<HTMLDetailsElement>(".article-toc");
  outline?.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>("a");
    if (!link) return;
    const section = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (!section) return;
    event.preventDefault();
    outline.open = false;
    history.pushState(null, "", link.hash);
    section.setAttribute("tabindex", "-1");
    section.focus({ preventScroll: true });
    section.scrollIntoView({ block: "start" });
  });
</script>
