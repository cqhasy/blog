---
import { navBarConfig, siteConfig } from "../config";
import { url, pathsEqual } from "../utils/url-utils";
import { LinkPresets } from "../constants/link-presets";
import SearchDialog from "./SearchDialog.astro";
const links = navBarConfig.links.map((link) => typeof link === "number" ? LinkPresets[link] : link);
const active = (path: string) => path === "/"
	? pathsEqual(Astro.url.pathname, url(path))
	: Astro.url.pathname.startsWith(url(path));
---
<header class="site-header" data-pagefind-ignore>
	<a class="site-name" href={url("/")} aria-label={`${siteConfig.title}，返回首页`}>
		<svg class="site-mark" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19.5 14.5A8.5 8.5 0 0 1 9.5 4.4 8.5 8.5 0 1 0 19.5 14.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
		{siteConfig.title}
	</a>
	<div class="header-links">
		<nav aria-label="主导航">
			{links.map((link) => <a href={url(link.url)} aria-current={active(link.url) ? "page" : undefined}>{link.name}</a>)}
		</nav>
		<div class="header-tools">
			<SearchDialog />
			<button id="theme-toggle" class="icon-button" type="button" aria-label="切换至深色模式" title="切换明暗主题">
				<svg class="theme-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 14.8A8.5 8.5 0 0 1 9.2 4a8.5 8.5 0 1 0 10.8 10.8Z" stroke="currentColor" stroke-width="1.5" /></svg>
				<svg class="theme-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" stroke="currentColor" stroke-width="1.5" /></svg>
			</button>
		</div>
	</div>
</header>
<script>
	const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
	const updateLabel = () => toggle?.setAttribute("aria-label", document.documentElement.classList.contains("dark") ? "切换至浅色模式" : "切换至深色模式");
	updateLabel();
	toggle?.addEventListener("click", () => {
		const dark = document.documentElement.classList.toggle("dark");
		try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch { /* Theme still works without storage. */ }
		updateLabel();
	});
	matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
		try {
			const theme = localStorage.getItem("theme");
			if (!theme || theme === "auto") {
				document.documentElement.classList.toggle("dark", event.matches);
				updateLabel();
			}
		} catch { /* Ignore unavailable storage. */ }
	});
</script>
