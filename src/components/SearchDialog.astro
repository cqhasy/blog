---
import ReadingIcon from "./ReadingIcon.astro";
---
<button class="icon-button" id="search-open" type="button" aria-label="搜索文章" aria-haspopup="dialog" aria-controls="reading-search" title="搜索文章（/）"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.5" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></button>
<dialog id="reading-search" class="search-dialog" aria-labelledby="search-title" data-pagefind-ignore data-base={import.meta.env.BASE_URL} data-production={import.meta.env.PROD}>
	<div class="search-dialog-header"><h2 id="search-title">找一篇文字</h2><button type="button" id="search-close" class="icon-button" aria-label="关闭搜索"><ReadingIcon name="close" /></button></div>
	<div class="search-input-wrap"><label for="reading-search-input">搜索标题、内容或标签</label><input type="search" id="reading-search-input" placeholder="输入关键词…" autocomplete="off" /></div>
	<p id="reading-search-status" class="search-status" role="status" aria-live="polite">输入关键词，搜索分享与随笔。</p>
	<div class="search-results" id="reading-search-results"></div>
</dialog>
<script is:inline>
(() => {
	const dialog = document.querySelector("#reading-search");
	const input = document.querySelector("#reading-search-input");
	const status = document.querySelector("#reading-search-status");
	const results = document.querySelector("#reading-search-results");
	let pagefindPromise;
	let fallbackPromise;
	let requestId = 0;
	let timer;
	const open = () => { dialog.showModal(); input.focus(); };
	document.querySelector("#search-open")?.addEventListener("click", open);
	document.querySelector("#search-close")?.addEventListener("click", () => dialog.close());
	dialog.addEventListener("click", (event) => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
	dialog.addEventListener("keydown", (event) => { if (event.key === "Escape") { event.preventDefault(); dialog.close(); } });
	dialog.addEventListener("close", () => { requestId++; clearTimeout(timer); input.value = ""; results.replaceChildren(); status.textContent = "输入关键词，搜索分享与随笔。"; });
	document.addEventListener("keydown", (event) => {
		if (event.key === "/" && !event.metaKey && !event.ctrlKey && !(event.target instanceof Element && event.target.closest("input, textarea, select, [contenteditable='true']")) && !dialog.open) { event.preventDefault(); open(); }
	});
	const renderResults = (items) => {
		results.replaceChildren();
		status.textContent = items.length ? `找到 ${items.length} 篇文字` : "没有找到相关文字，试试其他关键词。";
		for (const item of items.slice(0, 20)) {
			const link = document.createElement("a");
			link.href = item.url; link.className = "search-result";
			const title = document.createElement("strong"); title.textContent = item.title;
			const excerpt = document.createElement("p"); excerpt.textContent = item.text;
			link.append(title, excerpt); results.append(link);
		}
	};
	async function search(query, id) {
		if (!query) { results.replaceChildren(); status.textContent = "输入关键词，搜索分享与随笔。"; return; }
		status.textContent = "正在查找…";
		let items;
		if (dialog.dataset.production === "true") {
			pagefindPromise ??= import(`${dialog.dataset.base.replace(/\/$/, "")}/pagefind/pagefind.js`).catch(() => null);
			try {
				const pagefind = await pagefindPromise;
				if (pagefind) {
					const response = await pagefind.search(query);
					items = await Promise.all(response.results.slice(0, 20).map(async (result) => {
						const data = await result.data();
						const excerpt = new DOMParser().parseFromString(data.excerpt, "text/html").body.textContent || "";
						return { title: data.meta.title, url: data.url, text: excerpt };
					}));
				}
			} catch { /* Use real content search if the index cannot load. */ }
		}
		if (id !== requestId || !dialog.open) return;
		if (!items) {
			fallbackPromise ??= fetch(`${dialog.dataset.base.replace(/\/$/, "")}/search-index.json`).then((response) => {
				if (!response.ok) throw new Error("Search index unavailable");
				return response.json();
			});
			let fallback;
			try { fallback = await fallbackPromise; } catch {
				fallbackPromise = undefined;
				if (id === requestId && dialog.open) status.textContent = "暂时无法加载搜索，请稍后重试。";
				return;
			}
			if (id !== requestId || !dialog.open) return;
			items = fallback.filter((item) => `${item.title} ${item.text}`.toLocaleLowerCase().includes(query.toLocaleLowerCase())).map((item) => {
			const index = item.text.toLocaleLowerCase().indexOf(query.toLocaleLowerCase());
			const start = Math.max(0, index - 30);
			return { ...item, text: `${start ? "…" : ""}${item.text.slice(start, start + 120).replace(/[#*`>\n]/g, " ")}…` };
		});
		}
		renderResults(items);
	}
	input.addEventListener("input", () => { clearTimeout(timer); const id = ++requestId; const query = input.value.trim(); timer = setTimeout(() => void search(query, id), 180); });
})();
</script>
