---
import ReadingIcon from "./ReadingIcon.astro";
import type { WritingEntry } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";
interface Props {
	entry: WritingEntry;
	class?: string;
	[key: string]: unknown;
}
const { entry } = Astro.props;
const { remarkPluginFrontmatter } = await entry.render();
const fullDescription = entry.data.description || remarkPluginFrontmatter.excerpt || "";
const characters = Array.from(fullDescription);
const description = characters.length > 90 ? `${characters.slice(0, 90).join("")}…` : fullDescription;
const date = entry.data.published.toISOString().slice(0, 10);
---
<article class="writing-row">
	<div class="writing-date"><time datetime={date}>{date.replaceAll("-", ".")}</time>{entry.data.pinned && <span class="pinned-label">置顶</span>}</div>
	<div class="writing-info">
		<h3><a href={getPostUrlBySlug(entry.slug, entry.collection)}>{entry.data.title}</a></h3>
		{description && <p class="writing-excerpt">{description}</p>}
		<div class="writing-meta"><span class="reading-time"><ReadingIcon name="clock" size={13} />{remarkPluginFrontmatter.minutes || 1} 分钟<span class="sr-only">阅读</span></span>{entry.data.category && <><span aria-hidden="true">·</span><span>{entry.data.category}</span></>}{entry.data.draft && <span>草稿</span>}</div>
	</div>
	<ReadingIcon class="row-arrow" name="arrow-right" size={18} />
</article>
