---
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";
interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}
const { headings: _headings, ...props } = Astro.props;
---
<Layout {...props}>
	<slot name="head" slot="head" />
	<main id="main-content" class="reading-shell" tabindex="-1">
		<slot />
	</main>
</Layout>
